{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for ReadBridge desktop and webview",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-webview-position",
    "core:webview:allow-webview-size",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
